# RevenueCat public SDK keys. Keep real values in untracked local or EAS environments.
# Debug/development builds use only this Test Store key:
REVENUECAT_TEST_STORE_API_KEY=

# Release builds use only the matching platform key:
REVENUECAT_IOS_API_KEY=
REVENUECAT_ANDROID_API_KEY=

# AdMob public iOS identifiers for Release builds. Follow docs/ADMOB_SETUP.md;
# Debug/development builds use Google's sample inventory.
ADMOB_IOS_APP_ID=
ADMOB_IOS_BANNER_ID=
